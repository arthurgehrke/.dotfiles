Host *
  UserKnownHostsFile ~/.ssh/known_hosts
  UpdateHostKeys yes
  Compression yes
  AddKeysToAgent yes
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  ConnectTimeout 10
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 1h
  LogLevel VERBOSE

# Host github.com
#   Hostname ssh.github.com
#   IdentityFile ~/.ssh/GITHUB-MAC-SSH-ARTHUR

Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/GITHUB-MAC-KEY

Host gitlab.com
  IdentityFile ~/.ssh/GITLAB-MAC-SSH-ARTHUR
  ServerAliveCountMax 5

Host gist.github.com
  HostName gist.github.com
  User git
  IdentityFile ~/.ssh/GITHUB-MAC-SSH-ARTHUR
